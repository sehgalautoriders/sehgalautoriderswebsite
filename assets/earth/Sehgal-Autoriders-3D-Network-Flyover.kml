  <Document>
    <name>Sehgal Autoriders — 3D Aerial Network Flyover (15 Live + 4 Upcoming Hubs)</name>
    <open>1</open>
    <description><![CDATA[
      <b>Sehgal Autoriders Pvt. Ltd. — Google Earth 3D Photorealistic Network Tour</b><br/>
      15 Authorised Maruti Suzuki (Arena, NEXA, True Value, Commercial, Driving School) &amp; Hero MotoCorp (3S, Premia &amp; VIDA EV) Showrooms, Workshops &amp; Cashless Bodyshops across Pune, PCMC, Lonavala, Kamshet, Khed Shivapur &amp; Bhor.<br/>
      <b>Central Digital Desk:</b> +91 83800 38244 · ceoservice@sehgalautoriders.com
    ]]></description>

    <Style id="sehgalFlagshipStyle">
      <IconStyle>
        <scale>1.3</scale>
        <Icon><href>http://maps.google.com/mapfiles/kml/paddle/red-stars.png</href></Icon>
      </IconStyle>
      <LabelStyle><scale>1.1</scale></LabelStyle>
    </Style>
    <Style id="sehgalNexaStyle">
      <IconStyle>
        <scale>1.25</scale>
        <Icon><href>http://maps.google.com/mapfiles/kml/paddle/blu-stars.png</href></Icon>
      </IconStyle>
    </Style>
    <Style id="sehgalHeroStyle">
      <IconStyle>
        <scale>1.2</scale>
        <Icon><href>http://maps.google.com/mapfiles/kml/paddle/ylw-stars.png</href></Icon>
      </IconStyle>
    </Style>
    <Style id="sehgalUpcomingStyle">
      <IconStyle>
        <scale>1.15</scale>
        <Icon><href>http://maps.google.com/mapfiles/kml/paddle/grn-circle.png</href></Icon>
      </IconStyle>
    </Style>

    <gx:Tour>
      <name>Play 3D Aerial Flyover — All Sehgal Showrooms &amp; Hubs</name>
      <gx:Playlist>
        <gx:FlyTo>
          <gx:duration>4.5</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>73.7679774</longitude><latitude>18.5114847</latitude><altitude>0</altitude>
            <heading>42</heading><tilt>65</tilt><range>340</range>
            <gx:altitudeMode>relativeToSeaFloor</gx:altitudeMode>
          </LookAt>
        </gx:FlyTo>
        <gx:Wait><gx:duration>2.5</gx:duration></gx:Wait>

        <gx:FlyTo>
          <gx:duration>4.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>73.829510</longitude><latitude>18.514240</latitude><altitude>0</altitude>
            <heading>115</heading><tilt>65</tilt><range>320</range>
            <gx:altitudeMode>relativeToSeaFloor</gx:altitudeMode>
          </LookAt>
        </gx:FlyTo>
        <gx:Wait><gx:duration>2.0</gx:duration></gx:Wait>

        <gx:FlyTo>
          <gx:duration>4.5</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>73.903420</longitude><latitude>18.503850</latitude><altitude>0</altitude>
            <heading>210</heading><tilt>65</tilt><range>320</range>
            <gx:altitudeMode>relativeToSeaFloor</gx:altitudeMode>
          </LookAt>
        </gx:FlyTo>
        <gx:Wait><gx:duration>2.0</gx:duration></gx:Wait>

        <gx:FlyTo>
          <gx:duration>4.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>73.978100</longitude><latitude>18.496400</latitude><altitude>0</altitude>
            <heading>160</heading><tilt>64</tilt><range>380</range>
            <gx:altitudeMode>relativeToSeaFloor</gx:altitudeMode>
          </LookAt>
        </gx:FlyTo>
        <gx:Wait><gx:duration>2.0</gx:duration></gx:Wait>

        <gx:FlyTo>
          <gx:duration>4.5</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>73.792400</longitude><latitude>18.647200</latitude><altitude>0</altitude>
            <heading>75</heading><tilt>65</tilt><range>360</range>
            <gx:altitudeMode>relativeToSeaFloor</gx:altitudeMode>
          </LookAt>
        </gx:FlyTo>
        <gx:Wait><gx:duration>2.0</gx:duration></gx:Wait>

        <gx:FlyTo>
          <gx:duration>4.5</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>73.858800</longitude><latitude>18.753400</latitude><altitude>0</altitude>
            <heading>30</heading><tilt>64</tilt><range>380</range>
            <gx:altitudeMode>relativeToSeaFloor</gx:altitudeMode>
          </LookAt>
        </gx:FlyTo>
        <gx:Wait><gx:duration>2.0</gx:duration></gx:Wait>

        <gx:FlyTo>
          <gx:duration>5.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>73.440800</longitude><latitude>18.758200</latitude><altitude>0</altitude>
            <heading>295</heading><tilt>65</tilt><range>420</range>
            <gx:altitudeMode>relativeToSeaFloor</gx:altitudeMode>
          </LookAt>
        </gx:FlyTo>
        <gx:Wait><gx:duration>2.0</gx:duration></gx:Wait>

        <gx:FlyTo>
          <gx:duration>5.0</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>73.848200</longitude><latitude>18.338900</latitude><altitude>0</altitude>
            <heading>180</heading><tilt>65</tilt><range>380</range>
            <gx:altitudeMode>relativeToSeaFloor</gx:altitudeMode>
          </LookAt>
        </gx:FlyTo>
        <gx:Wait><gx:duration>2.0</gx:duration></gx:Wait>

        <gx:FlyTo>
          <gx:duration>4.5</gx:duration>
          <gx:flyToMode>smooth</gx:flyToMode>
          <LookAt>
            <longitude>73.844500</longitude><latitude>18.148600</latitude><altitude>0</altitude>
            <heading>145</heading><tilt>65</tilt><range>400</range>
            <gx:altitudeMode>relativeToSeaFloor</gx:altitudeMode>
          </LookAt>
        </gx:FlyTo>
      </gx:Playlist>
    </gx:Tour>

